# 2(b) List operations
my_list = [1, 2, 3, 4, 5]
print("Original list:", my_list)

my_list.insert(2, 10)
print("After inserting 10 at position 2:", my_list)

my_list.remove(3)
print("After removing 3:", my_list)

my_list.append(6)
print("After appending 6:", my_list)

print("Length of the list:", len(my_list))
removed_item = my_list.pop()
print("Popped element:", removed_item)
print("List after popping:", my_list)

removed_item = my_list.pop(0)
print("Popped first element:", removed_item)
print("List after popping first element:", my_list)

my_list.clear()
print("After clearing the list:", my_list)
